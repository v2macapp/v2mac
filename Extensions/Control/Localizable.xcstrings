    "Shows the connection and turns it on or off." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وضعیت اتصال را نشان می‌دهد و آن را روشن یا خاموش می‌کند."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示连接状态并可开关连接。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает подключение и включает или выключает его."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض حالة الاتصال ويشغّله أو يوقفه."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị kết nối và cho phép bật hoặc tắt."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示連線狀態並可開關連線。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ချိတ်ဆက်မှုကို ပြသပြီး ဖွင့်ရန် သို့မဟုတ် ပိတ်ရန်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantıyı gösterir, açar veya kapatır."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche la connexion et permet de l’activer ou de la désactiver."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کنکشن کی حالت دکھاتا ہے اور اسے چلاتا یا بند کرتا ہے۔"
          }
        },
        "pt" : {
