    "Measures the real delay of the servers in a group, or of every server, and returns those that answered, fastest first." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأخیر واقعی سرورهای یک گروه یا همهٔ سرورها را می‌سنجد و آن‌هایی را که پاسخ دادند، از سریع‌ترین، برمی‌گرداند."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Измеряет реальную задержку серверов группы или всех серверов и возвращает ответившие, начиная с самого быстрого."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "测量一个分组或所有服务器的真实延迟，并按从快到慢返回有响应的服务器。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقيس زمن الاستجابة الحقيقي للخوادم في مجموعة، أو لكل الخوادم، ويعيد الخوادم التي استجابت مرتبة من الأسرع."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đo độ trễ thực của các máy chủ trong một nhóm hoặc tất cả máy chủ, rồi trả về những máy chủ có phản hồi, xếp máy nhanh nhất trước."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "測量一個分組或所有伺服器的真實延遲，並按從快到慢返回有響應的伺服器。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အုပ်စုတစ်ခုရှိ ဆာဗာများ သို့မဟုတ် ဆာဗာအားလုံး၏ အမှန်တကယ်နှောင့်နှေးချိန်ကို တိုင်းတာပြီး တုံ့ပြန်သည့်ဆာဗာများကို အမြန်ဆုံးမှစ၍ ပြန်ပေးသည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir gruptaki veya tüm sunucuların gerçek gecikmesini ölçer ve yanıt verenleri en hızlıdan başlayarak döndürür."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesure la latence réelle des serveurs d’un groupe ou de tous les serveurs, puis renvoie ceux qui ont répondu, du plus rapide au plus lent."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کسی گروپ کے سرورز یا تمام سرورز کی حقیقی تاخیر ناپتا ہے اور جواب دینے والے سرورز لوٹاتا ہے، تیز ترین پہلے۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mede a latência real dos servidores de um grupo, ou de todos os servidores, e apresenta os que responderam, do mais rápido ao mais lento."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misst die tatsächliche Latenz der Server einer Gruppe oder aller Server und gibt die antwortenden Server zurück, die schnellsten zuerst."
          }
        }
      }
    },
    "Measures the servers in a group, or every server, and connects to the one with the lowest real delay." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سرورهای یک گروه یا همهٔ سرورها را می‌سنجد و به سروری با کمترین تأخیر واقعی وصل می‌شود."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Измеряет серверы группы или все серверы и подключается к серверу с наименьшей реальной задержкой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "测量一个分组或所有服务器，并连接真实延迟最低的那个。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقيس الخوادم في مجموعة، أو كل الخوادم، ويتصل بأقلها زمن استجابة حقيقيًا."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đo các máy chủ trong một nhóm hoặc tất cả máy chủ, rồi kết nối đến máy chủ có độ trễ thực thấp nhất."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "測量一個分組或所有伺服器，並連線真實延遲最低的那個。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အုပ်စုတစ်ခုရှိ ဆာဗာများ သို့မဟုတ် ဆာဗာအားလုံးကို တိုင်းတာပြီး အမှန်တကယ်နှောင့်နှေးချိန် အနည်းဆုံးဆာဗာသို့ ချိတ်ဆက်သည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir gruptaki veya tüm sunucuları ölçer ve gerçek gecikmesi en düşük olana bağlanır."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teste les serveurs d’un groupe ou tous les serveurs, puis se connecte à celui dont la latence réelle est la plus faible."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کسی گروپ کے سرورز یا تمام سرورز کو جانچتا ہے اور کم ترین حقیقی تاخیر والے سرور سے رابطہ قائم کرتا ہے۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mede a latência real dos servidores de um grupo, ou de todos os servidores, e estabelece ligação com o que tiver a menor latência."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misst die Server einer Gruppe oder alle Server und verbindet sich mit dem Server mit der niedrigsten tatsächlichen Latenz."
          }
        }
      }
    },
