    "Rules are checked from the top; the first that matches decides where traffic goes." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قانون‌ها از بالا بررسی می‌شوند؛ نخستین قانونِ منطبق تعیین می‌کند ترافیک کجا برود."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правила проверяются сверху; первое совпавшее решает, куда идёт трафик."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "规则从上往下检查；第一条匹配的规则决定流量去向。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُفحص القواعد من الأعلى؛ وتحدد أول قاعدة مطابقة مسار حركة البيانات."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các quy tắc là checked từ top; trước that matches decides where lưu lượng goes."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "規則從上往下檢查；第一條匹配的規則決定流量去向。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "စည်းမျဉ်းများကို အပေါ်မှစစ်သည်။ ပထမဆုံးကိုက်ညီသော စည်းမျဉ်းက ဒေတာပို့မည့်နေရာကို ဆုံးဖြတ်သည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurallar yukarıdan aşağı denetlenir; ilk eşleşen, trafiğin nereye gideceğini belirler."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les règles sont évaluées de haut en bas ; la première correspondance détermine où va le trafic."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قواعد اوپر سے جانچے جاتے ہیں؛ پہلا مطابقت رکھنے والا قاعدہ طے کرتا ہے کہ ٹریفک کہاں جائے گی۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As regras são verificadas de cima para baixo; a primeira que corresponder determina o destino do tráfego."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regeln werden von oben geprüft. Die erste passende Regel bestimmt den Weg des Datenverkehrs."
          }
        }
      }
    },
