        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service auxiliaire du bac à sable a été modifié sur le disque. Supprimez le bac à sable et téléchargez-le à nouveau."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ڈسک پر موجود سینڈ باکس کا معاون پروگرام تبدیل کر دیا گیا ہے۔ سینڈ باکس ہٹا کر دوبارہ ڈاؤن لوڈ کریں۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
