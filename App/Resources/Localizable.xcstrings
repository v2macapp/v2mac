        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر مساعد البيئة المعزولة على القرص. أزل البيئة ونزّلها مجددًا."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hộp cát trình trợ giúp trên disk đã changed. xóa hộp cát và tải xuống it lại."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁盤上的沙盒輔助程序已被更改。請移除沙盒並重新下載。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဒစ်ပေါ်ရှိ sandbox အကူပရိုဂရမ် ပြောင်းလဲထားသည်။ sandbox ကို ဖယ်ရှားပြီး ပြန်ဒေါင်းလုဒ်လုပ်ပါ။"
