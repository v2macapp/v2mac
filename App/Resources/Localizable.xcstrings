    "Tells whether V2Mac is connected, to which server, and where traffic comes out." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "می‌گوید V2Mac متصل است یا نه، به کدام سرور، و ترافیک از کجا خارج می‌شود."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщает, подключён ли V2Mac, к какому серверу и где выходит трафик."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉你 V2Mac 是否已连接、连接到哪台服务器以及流量出口。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوضح ما إذا كان V2Mac متصلًا، وبأي خادم، ومن أين تخرج حركة البيانات."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tells whether V2Mac là connected, đến which máy chủ, và where lưu lượng comes out."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告訴你 V2Mac 是否已連線、連線到哪台伺服器以及流量出口。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac ချိတ်ဆက်ထားခြင်း ရှိမရှိ၊ မည်သည့်ဆာဗာနှင့် ချိတ်ထားသည်၊ ဒေတာမည်သည့်နေရာမှ ထွက်သည်ကို ပြသည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac'in bağlı olup olmadığını, hangi sunucuya bağlandığını ve trafiğin çıkış noktasını bildirir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique si V2Mac est connecté, à quel serveur et par où le trafic sort."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بتاتا ہے کہ V2Mac جڑا ہے یا نہیں، کس سرور سے جڑا ہے، اور ٹریفک کہاں سے خارج ہوتی ہے۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica se o V2Mac está conectado, a que servidor e por onde sai o tráfego."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt, ob V2Mac verbunden ist, mit welchem Server und wo der Datenverkehr austritt."
          }
        }
      }
    },
