    "Pings %lld random Cloudflare addresses on port %@, then tries the fastest %lld as %@. The server's name stays as SNI and Host." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld آدرس تصادفی Cloudflare روی پورت %2$@ پینگ می‌شوند، سپس %3$lld آدرس سریع‌تر به‌جای %4$@ امتحان می‌شوند. نام سرور به‌عنوان SNI و Host باقی می‌ماند."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пингуются %1$lld случайных адресов Cloudflare на порту %2$@, затем %3$lld самых быстрых проверяются как %4$@. Имя сервера остаётся в SNI и Host."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对 %1$lld 个随机 Cloudflare 地址的 %2$@ 端口进行 ping，然后把最快的 %3$lld 个作为 %4$@ 测试。服务器名称仍用作 SNI 和 Host。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يختبر %lld عنوانًا عشوائيًا لـ Cloudflare على المنفذ %@، ثم يجرّب أسرع %lld بصفة %@. يبقى اسم الخادم في SNI وHost."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pings %lld random Cloudflare địa chỉ trên cổng %@, then tries fastest %lld as %@. máy chủ's tên stays as SNI và máy chủ."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對 %1$lld 個隨機 Cloudflare 地址的 %2$@ 端口進行 ping，然後把最快的 %3$lld 個作為 %4$@ 測試。伺服器名稱仍用作 SNI 和 Host。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ကျပန်း Cloudflare လိပ်စာ %lld ခုကို port %@ တွင် Ping စမ်းပြီး အမြန်ဆုံး %lld ခုကို %@ အဖြစ် စမ်းသည်။ ဆာဗာအမည်ကို SNI နှင့် Host အဖြစ် ဆက်သုံးသည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld rastgele Cloudflare adresine %@ bağlantı noktasından ping gönderir, sonra en hızlı %lld adresi %@ olarak dener. Sunucu adı SNI ve Host olarak kalır."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teste par ping %lld adresses Cloudflare aléatoires sur le port %@, puis essaie les %lld plus rapides comme %@. Le nom du serveur reste utilisé pour SNI et Host."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloudflare کے %lld بے ترتیب پتوں کو پورٹ %@ پر پنگ کرتا ہے، پھر تیز ترین %lld کو بطور %@ آزماتا ہے۔ سرور کا نام SNI اور Host ہی رہتا ہے۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testa %lld endereços aleatórios da Cloudflare com ping na porta %@ e depois experimenta os %lld mais rápidos como %@. O nome do servidor mantém-se como SNI e Host."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüft %lld zufällige Cloudflare-Adressen an Port %@ und testet anschließend die schnellsten %lld als %@. Der Servername bleibt als SNI und Host erhalten."
          }
        }
      }
    },
