    "Its network and protocol conditions contradict each other: QUIC runs over UDP, TLS and HTTP over TCP." : {
      "extractionState" : "manual",
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شرط‌های شبکه و پروتکلش با هم تناقض دارند: QUIC روی UDP و TLS و HTTP روی TCP کار می‌کنند."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Условия сети и протокола противоречат друг другу: QUIC работает по UDP, TLS и HTTP — по TCP."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其网络和协议条件相互矛盾：QUIC 基于 UDP，TLS 和 HTTP 基于 TCP。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتعارض شروط الشبكة والبروتوكول: يعمل QUIC عبر UDP، ويعمل TLS وHTTP عبر TCP."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều kiện mạng và giao thức mâu thuẫn nhau: QUIC chạy trên UDP, còn TLS và HTTP chạy trên TCP."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其網路和協議條件相互矛盾：QUIC 基於 UDP，TLS 和 HTTP 基於 TCP。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "၎င်း၏ ကွန်ရက်နှင့် ပရိုတိုကောသတ်မှတ်ချက်များ ဆန့်ကျင်နေသည်။ QUIC သည် UDP ပေါ်တွင်၊ TLS နှင့် HTTP သည် TCP ပေါ်တွင် အလုပ်လုပ်သည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağ ve protokol koşulları çelişiyor: QUIC, UDP üzerinden; TLS ve HTTP, TCP üzerinden çalışır."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses conditions de réseau et de protocole se contredisent : QUIC utilise UDP, TLS et HTTP utilisent TCP."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس کی نیٹ ورک اور پروٹوکول کی شرائط متضاد ہیں: QUIC، UDP پر چلتا ہے، جبکہ TLS اور HTTP، TCP پر چلتے ہیں۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As condições de rede e protocolo contradizem-se: QUIC usa UDP, TLS e HTTP usam TCP."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Netzwerk- und Protokollbedingungen widersprechen sich: QUIC verwendet UDP, TLS und HTTP verwenden TCP."
          }
        }
      }
    },
