    "geosite lists match names, geoip lists match addresses." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فهرست‌های geosite با نام‌ها و فهرست‌های geoip با آدرس‌ها تطبیق داده می‌شوند."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Списки geosite сопоставляются с именами, geoip — с адресами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "geosite 列表匹配域名，geoip 列表匹配地址。"
