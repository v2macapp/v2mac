    "A mini VM whose exit stops working is blocked until you pick another server; it never switches by itself." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ماشین مجازی کوچکی که خروجی‌اش از کار بیفتد تا وقتی سرور دیگری انتخاب کنید مسدود می‌ماند؛ هرگز خودش سرور را عوض نمی‌کند."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мини-ВМ, чей выход перестал работать, блокируется, пока вы не выберете другой сервер; сама она сервер не меняет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出口停止工作的迷你虚拟机会被阻断，直到你选择另一台服务器；它从不自行切换。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحظر الآلة الافتراضية المصغّرة التي يتوقف منفذها عن العمل إلى أن تختار خادمًا آخر؛ ولا تبدّل الخادم تلقائيًا أبدًا."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy ảo mini có lối ra ngừng hoạt động sẽ bị chặn cho đến khi bạn chọn máy chủ khác; nó không bao giờ tự chuyển."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出口停止工作的迷你虛擬機會被阻斷，直到你選擇另一台伺服器；它從不自行切換。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အထွက်လမ်းကြောင်း အလုပ်မလုပ်တော့သော mini VM ကို အခြားဆာဗာရွေးသည်အထိ ပိတ်ဆို့ထားမည်။ အလိုအလျောက် မပြောင်းပါ။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çıkışı çalışmayı bırakan mini VM, siz başka sunucu seçene kadar engellenir; kendiliğinden geçiş yapmaz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une mini VM dont la sortie ne fonctionne plus est bloquée jusqu’à ce que vous choisissiez un autre serveur ; elle ne change jamais de serveur automatiquement."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جس چھوٹی VM کا خروج کام کرنا بند کر دے، وہ آپ کے دوسرا سرور منتخب کرنے تک مسدود رہتی ہے؛ یہ کبھی خود سے سرور نہیں بدلتی۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma mini VM cuja saída deixa de funcionar fica bloqueada até que escolha outro servidor; nunca muda de servidor automaticamente."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fällt der Ausgang einer Mini-VM aus, wird sie blockiert, bis Sie einen anderen Server wählen. Sie wechselt niemals selbstständig."
          }
        }
      }
    },
