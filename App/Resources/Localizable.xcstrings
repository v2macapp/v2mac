    "Downloads a new version in the background and installs it when V2Mac quits." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخهٔ جدید را در پس‌زمینه دانلود می‌کند و هنگام بستن V2Mac نصب می‌کند."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загружает новую версию в фоне и устанавливает её при выходе из V2Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在后台下载新版本，并在 V2Mac 退出时安装。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينزّل إصدارًا جديدًا في الخلفية ويثبّته عند إنهاء V2Mac."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tải phiên bản mới trong nền và cài đặt khi V2Mac thoát."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在後台下載新版本，並在 V2Mac 退出時安裝。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဗားရှင်းအသစ်ကို နောက်ခံတွင် ဒေါင်းလုဒ်လုပ်ပြီး V2Mac ပိတ်ချိန်တွင် ထည့်သွင်းသည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni sürümü arka planda indirir ve V2Mac kapandığında yükler."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharge une nouvelle version en arrière-plan et l’installe à la fermeture de V2Mac."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نیا نسخہ پس منظر میں ڈاؤن لوڈ کرتا ہے اور V2Mac بند ہونے پر نصب کرتا ہے۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transfere uma nova versão em segundo plano e instala-a quando o V2Mac é encerrado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt eine neue Version im Hintergrund herunter und installiert sie, wenn V2Mac beendet wird."
          }
        }
      }
    },
