            "value" : "L’autorisation n’a pas encore été demandée à macOS"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابھی macOS سے اجازت نہیں مانگی گئی"
          }
        },
        "pt" : {
          "stringUnit" : {
