    "Connect first: with the kill switch on, V2Mac downloads only through the connection." : {
      "extractionState" : "manual",
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اول وصل شوید: وقتی کلید قطع اضطراری روشن است، V2Mac فقط از راه اتصال دانلود می‌کند."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала подключитесь: при включённой блокировке трафика V2Mac загружает только через соединение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先连接：开启断网保护时，V2Mac 只通过连接下载。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتصل أولًا: عند تشغيل مفتاح قطع الاتصال، لا ينزّل V2Mac إلا عبر الاتصال."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy kết nối trước: khi ngắt mạng khẩn cấp đang bật, V2Mac chỉ tải xuống qua kết nối."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先連線：開啓斷網保護時，V2Mac 只通過連線下載。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အရင်ချိတ်ဆက်ပါ။ ချိတ်ဆက်မှုပြတ်လျှင် ပိတ်ဆို့စနစ် ဖွင့်ထားချိန်တွင် V2Mac သည် ချိတ်ဆက်မှုမှတစ်ဆင့်သာ ဒေါင်းလုဒ်လုပ်သည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce bağlanın: bağlantı kesme koruması açıkken V2Mac yalnızca bağlantı üzerinden indirir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous d’abord : lorsque le coupe-circuit est activé, V2Mac télécharge uniquement via la connexion."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پہلے جڑیں: انٹرنیٹ بندش سے تحفظ فعال ہونے پر V2Mac صرف اسی کنکشن کے ذریعے ڈاؤن لوڈ کرتا ہے۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estabeleça primeiro a ligação: com o bloqueio de emergência ativado, o V2Mac só faz transferências através da ligação."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuerst verbinden: Bei aktiviertem Kill Switch lädt V2Mac nur über die Verbindung herunter."
          }
        }
      }
    },
