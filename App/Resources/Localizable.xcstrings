    "Blocks all traffic outside the V2Mac connection while it is wanted, or turns that off." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تا وقتی اتصال V2Mac خواسته شده، همه ترافیک بیرون از آن را مسدود می‌کند، یا این را خاموش می‌کند."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блокирует весь трафик вне подключения V2Mac, пока оно нужно, или выключает это."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在需要连接时拦截 V2Mac 连接之外的所有流量，或关闭此功能。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحظر كل حركة البيانات خارج اتصال V2Mac عند طلبه، أو يوقف ذلك."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chặn toàn bộ lưu lượng bên ngoài kết nối V2Mac khi cần hoặc tắt việc chặn đó."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在需要連線時攔截 V2Mac 連線之外的所有流量，或關閉此功能。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac ချိတ်ဆက်မှု လိုအပ်နေစဉ် ၎င်းပြင်ပရှိ ဒေတာစီးဆင်းမှုအားလုံးကို ပိတ်ဆို့သည်၊ သို့မဟုတ် ထိုလုပ်ဆောင်ချက်ကို ပိတ်သည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantı istendiği sürece V2Mac bağlantısı dışındaki tüm trafiği engeller veya bu korumayı kapatır."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloque tout trafic hors de la connexion V2Mac tant que celle-ci est demandée, ou désactive ce blocage."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کنکشن مطلوب ہونے کے دوران V2Mac کنکشن سے باہر کی تمام ٹریفک مسدود کرتا ہے، یا یہ بند کر دیتا ہے۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueia todo o tráfego fora da ligação de V2Mac enquanto esta deve permanecer ativa, ou desativa esse bloqueio."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blockiert den gesamten Datenverkehr außerhalb der V2Mac-Verbindung, solange diese gewünscht ist, oder hebt die Blockierung auf."
          }
        }
      }
    },
