    "Every item above must also meet these. Leave them empty to match any port, network, protocol and app." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر مورد بالا باید این‌ها را هم داشته باشد. برای تطبیق با هر درگاه، شبکه، پروتکل و برنامه خالی بگذارید."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый элемент выше должен также соответствовать этим условиям. Оставьте пустыми, чтобы подходили любые порт, сеть, протокол и приложение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上面的每一项还必须满足这些条件。留空则匹配任意端口、网络、协议和应用。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن يطابق كل عنصر أعلاه هذه الشروط أيضًا. اتركها فارغة لمطابقة أي منفذ وشبكة وبروتوكول وتطبيق."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi mục ở trên cũng phải đáp ứng các điều kiện này. Để trống để khớp với mọi cổng, mạng, giao thức và ứng dụng."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上面的每一項還必須滿足這些條件。留空則匹配任意端口、網路、協議和應用。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အထက်ပါအရာတစ်ခုစီသည် ဤသတ်မှတ်ချက်များနှင့်လည်း ကိုက်ညီရမည်။ မည်သည့် port၊ ကွန်ရက်၊ ပရိုတိုကောနှင့် အက်ပ်ကိုမဆို ကိုက်ညီစေရန် အလွတ်ထားပါ။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yukarıdaki her öğe bunları da karşılamalıdır. Tüm bağlantı noktaları, ağlar, protokoller ve uygulamalarla eşleşmek için boş bırakın."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque élément ci-dessus doit aussi respecter ces critères. Laissez-les vides pour accepter tous les ports, réseaux, protocoles et apps."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اوپر کی ہر شے کو یہ شرائط بھی پوری کرنی ہوں گی۔ کسی بھی پورٹ، نیٹ ورک، پروٹوکول اور ایپ سے مطابقت کے لیے انہیں خالی چھوڑ دیں۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada item acima também deve cumprir estas condições. Deixe os campos vazios para abranger qualquer porta, rede, protocolo e aplicação."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder obige Eintrag muss auch diese Bedingungen erfüllen. Lassen Sie die Felder leer, um beliebige Ports, Netzwerke, Protokolle und Apps zu erfassen."
          }
        }
      }
    },
