          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此構建在每次會話中使用 macOS 管理員對話框。托管輔助程序需要使用 Apple 證書簽名的構建。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဤ build သည် စက်ရှင်တိုင်းတွင် macOS စီမံခန့်ခွဲသူ ဒိုင်ယာလော့ခ်ကို သုံးသည်။ စီမံထားသော အကူပရိုဂရမ်အတွက် Apple လက်မှတ်ထိုးထားသော build လိုအပ်သည်။"
