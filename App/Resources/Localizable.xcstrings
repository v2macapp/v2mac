    "%lld rules will be added after your rules, so yours keep their priority. Nothing changes until you apply." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld قانون بعد از قانون‌های شما اضافه می‌شود تا قانون‌های شما اولویت خود را نگه دارند. تا اعمال نکنید چیزی تغییر نمی‌کند."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правил будет добавлено после ваших: %lld, так что ваши сохранят приоритет. Ничего не изменится, пока вы не примените."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将在你的规则之后添加 %lld 条规则，你的规则仍然优先。应用之前不会有任何改变。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُضاف %lld قواعد بعد قواعدك، لتحتفظ قواعدك بأولويتها. لن يتغير شيء حتى تطبّق."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld quy tắc sẽ được thêm sau các quy tắc của bạn để chúng vẫn giữ ưu tiên. Không có gì thay đổi cho đến khi bạn áp dụng."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將在你的規則之後加入 %lld 條規則，你的規則仍然優先。應用之前不會有任何改變。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင့်စည်းမျဉ်းများနောက်တွင် စည်းမျဉ်း %lld ခု ထည့်မည်ဖြစ်၍ သင့်စည်းမျဉ်းများက ဦးစားပေးအဖြစ် ဆက်ရှိမည်။ အသုံးမချမချင်း ဘာမှမပြောင်းပါ။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld kural, önceliğiniz korunacak şekilde kurallarınızın sonuna eklenecek. Uygulayana kadar hiçbir şey değişmez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld règles seront ajoutées après les vôtres, qui restent prioritaires. Rien ne change avant l’application des modifications."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے قواعد کے بعد %lld قواعد شامل کیے جائیں گے، اس لیے آپ کے قواعد کو ترجیح حاصل رہے گی۔ لاگو کرنے تک کچھ نہیں بدلے گا۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld regras serão adicionadas depois das suas, para que estas mantenham a prioridade. Nada muda até aplicar as alterações."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Regeln werden nach deinen Regeln eingefügt, damit deine Vorrang behalten. Erst beim Anwenden werden die Änderungen wirksam."
          }
        }
      }
    },
