    "One has the apps, the other the hosts; one rule with both does the same." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یکی برنامه‌ها را دارد و دیگری میزبان‌ها را؛ یک قانون با هر دو همان کار را می‌کند."
          }
        },
        "ru" : {
          "stringUnit" : {
