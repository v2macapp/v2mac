    "Enter the license key of a WARP+ account to use its plan on this device." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کلید لایسنس یک حساب WARP+ را وارد کنید تا طرح آن روی این دستگاه فعال شود."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите лицензионный ключ аккаунта WARP+, чтобы использовать его тариф на этом устройстве."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入 WARP+ 账户的许可证密钥，即可在此设备上使用其套餐。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل مفتاح ترخيص حساب WARP+ لاستخدام خطته على هذا الجهاز."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter license khóa of WARP+ account đến dùng của nó plan trên this device."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輸入 WARP+ 帳號的許可證密鑰，即可在此設備上使用其套餐。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဤစက်တွင် WARP+ အစီအစဉ်ကို သုံးရန် အကောင့်၏ လိုင်စင်သော့ ထည့်ပါ။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu aygıtta WARP+ planını kullanmak için hesabın lisans anahtarını girin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez la clé de licence d’un compte WARP+ pour utiliser son forfait sur cet appareil."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس آلے پر WARP+ کا منصوبہ استعمال کرنے کے لیے اس اکاؤنٹ کی لائسنس کلید درج کریں۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduza a chave de licença de uma conta WARP+ para usar o respetivo plano neste dispositivo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie den Lizenzschlüssel eines WARP+-Kontos ein, um dessen Tarif auf diesem Gerät zu nutzen."
          }
        }
