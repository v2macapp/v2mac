    "Returns the public IP address traffic comes out at, as V2Mac last checked it after connecting." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نشانی IP عمومی‌ای را که ترافیک از آن خارج می‌شود برمی‌گرداند، همان‌طور که V2Mac آخرین بار پس از اتصال بررسی کرد."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
