    "Also replaces a custom config's own fallback. Direct mode sends everything direct." : {
      "extractionState" : "stale",
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جایگزین مسیر پیش‌فرض پیکربندی سفارشی هم می‌شود. حالت مستقیم همه‌چیز را مستقیم می‌فرستد."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Также заменяет запасной маршрут собственного конфига. В режиме «Напрямую» всё идёт напрямую."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也会替代自定义配置自身的回退。直连模式下所有流量都直连。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستبدل أيضًا احتياط الإعداد المخصص نفسه. يرسل الوضع المباشر كل شيء مباشرة."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cũng thay thế phương án dự phòng riêng của cấu hình tùy chỉnh. Chế độ Trực tiếp gửi mọi thứ trực tiếp."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也會替代自定義配置自身的回退。直連模式下所有流量都直連。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "စိတ်ကြိုက်ဖွဲ့စည်းမှု၏ မူလအစားထိုးလမ်းကြောင်းကိုလည်း အစားထိုးမည်။ တိုက်ရိုက်မုဒ်တွင် အားလုံးကို တိုက်ရိုက်ပို့သည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özel yapılandırmanın kendi yedek yolunu da değiştirir. Doğrudan modu her şeyi doğrudan gönderir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplace aussi l’action par défaut de la configuration personnalisée. Le mode Direct achemine tout le trafic directement."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حسب ضرورت ترتیبات کا اپنا متبادل راستہ بھی بدل دیتا ہے۔ براہ راست موڈ تمام ٹریفک براہ راست بھیجتا ہے۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também substitui o destino alternativo da própria configuração personalizada. O modo Direto encaminha todo o tráfego diretamente."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersetzt auch den Ausweichweg einer eigenen Konfiguration. Im Direktmodus wird alles direkt gesendet."
          }
        }
      }
    },
