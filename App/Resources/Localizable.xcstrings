    "Removing deletes the sandbox, every mini VM with its data, and the sandbox apps. It can be downloaded again later." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذف، سندباکس، همهٔ ماشین‌های مجازی کوچک با داده‌هایشان و برنامه‌های سندباکس را پاک می‌کند. بعداً می‌توان دوباره آن را دانلود کرد."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаление стирает песочницу, все мини-ВМ с их данными и приложения песочницы. Её можно скачать снова позже."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除会删除沙盒、所有迷你虚拟机及其数据以及沙盒应用。之后可以重新下载。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تؤدي الإزالة إلى حذف البيئة المعزولة وكل آلة افتراضية مصغّرة وبياناتها وتطبيقات البيئة. ويمكن تنزيلها مجددًا لاحقًا."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc gỡ bỏ sẽ xóa hộp cát, mọi máy ảo mini cùng dữ liệu và các ứng dụng hộp cát. Bạn có thể tải lại sau."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除會刪除沙盒、所有迷你虛擬機及其資料以及沙盒應用。之後可以重新下載。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဖယ်ရှားလျှင် sandbox၊ mini VM အားလုံးနှင့် ၎င်းတို့၏ဒေတာ၊ sandbox အက်ပ်များကို ဖျက်မည်။ နောက်မှ ပြန်ဒေါင်းလုဒ်လုပ်နိုင်သည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaldırma işlemi sandbox'ı, tüm mini VM'leri ve verilerini, sandbox uygulamalarını siler. Daha sonra yeniden indirilebilir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression efface le bac à sable, toutes les mini VM et leurs données, ainsi que les apps du bac à sable. Il pourra être téléchargé à nouveau ultérieurement."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہٹانے سے سینڈباکس، ہر چھوٹی VM اس کے ڈیٹا سمیت، اور سینڈباکس کی ایپس حذف ہو جائیں گی۔ اسے بعد میں دوبارہ ڈاؤن لوڈ کیا جا سکتا ہے۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A remoção apaga o ambiente isolado, todas as mini VM com os respetivos dados e as aplicações do ambiente isolado. Pode voltar a descarregá-lo mais tarde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Entfernen werden die Sandbox, alle Mini-VMs samt Daten und die Sandbox-Apps gelöscht. Sie kann später erneut heruntergeladen werden."
          }
        }
      }
    },
