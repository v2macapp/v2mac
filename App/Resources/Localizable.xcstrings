    "Apps open in the Secure Sandbox (beta) close when V2Mac quits." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه‌های باز در سندباکس امن (بتا) با بستن V2Mac بسته می‌شوند."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложения, открытые в безопасной песочнице (бета), закрываются при выходе из V2Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac 退出时，安全沙盒（测试版）中打开的应用会关闭。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُغلق التطبيقات المفتوحة في البيئة المعزولة الآمنة (تجريبية) عند إنهاء V2Mac."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng đang mở trong Hộp cát bảo mật (beta) sẽ đóng khi V2Mac thoát."
