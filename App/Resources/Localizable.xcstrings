    "Each setting is tried twice against %@, each through its own test core. Your connection is not touched." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر تنظیم دو بار روی %@ امتحان می‌شود، هر کدام با هسته‌ی آزمایشی خودش. به اتصال شما دست زده نمی‌شود."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждая настройка проверяется дважды на %@, каждая через своё тестовое ядро. Ваше подключение не затрагивается."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每种设置都会针对 %@ 测试两次，各自使用独立的测试核心。不会影响你当前的连接。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُجرّب كل إعداد مرتين مع %@، وكل مرة عبر نواة اختبار مستقلة. لن يتأثر اتصالك."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi thiết lập được thử hai lần với %@, mỗi lần qua một lõi thử nghiệm riêng. Kết nối của bạn không bị ảnh hưởng."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每種設定都會針對 %@ 測試兩次，各自使用獨立的測試核心。不會影響你當前的連線。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဆက်တင်တစ်ခုစီကို သီးခြားစမ်းသပ် core ဖြင့် %@ သို့ နှစ်ကြိမ်စမ်းသပ်သည်။ သင့်ချိတ်ဆက်မှုကို မထိခိုက်ပါ။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her ayar %@ sunucusunda, kendine ait test çekirdeğiyle iki kez denenir. Bağlantınıza dokunulmaz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque réglage est testé deux fois avec %@, via un moteur de test distinct. Votre connexion reste inchangée."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر ترتیب کو %@ کے ساتھ دو بار آزمایا جاتا ہے، ہر بار اپنے الگ آزمائشی انجن کے ذریعے۔ آپ کا رابطہ متاثر نہیں ہوتا۔"
          }
        },
        "pt" : {
          "stringUnit" : {
