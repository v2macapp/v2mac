    "Picking another server replaces it inside the running core, so the local port stays up. Full Xray configs always restart." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتخاب سرور دیگر، آن را داخل هسته در حال اجرا جایگزین می‌کند، پس پورت محلی برقرار می‌ماند. کانفیگ‌های کامل Xray همیشه از نو شروع می‌شوند."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбранный сервер заменяется внутри работающего ядра, поэтому локальный порт не пропадает. Полные конфигурации Xray всегда перезапускаются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择其他服务器时会在运行中的内核里直接替换，本地端口保持可用。完整的 Xray 配置总是会重启。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستبدل اختيار خادم آخر الخادم داخل النواة الجارية، فيبقى المنفذ المحلي متاحًا. تعيد إعدادات Xray الكاملة التشغيل دائمًا."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Picking another máy chủ replaces it inside đang chạy lõi, so local cổng stays up. Full Xray các cấu hình always restart."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇其他伺服器時會在運行中的內核里直接替換，本地端口保持可用。完整的 Xray 配置總是會重啓。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အခြားဆာဗာရွေးလျှင် လည်ပတ်နေသော core အတွင်း အစားထိုးသဖြင့် စက်တွင်း port ဆက်ဖွင့်နေမည်။ Xray ဆက်တင်အပြည့်အစုံအတွက် အမြဲ ပြန်စမည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka sunucu seçmek, çalışan çekirdekte sunucuyu değiştirir; böylece yerel bağlantı noktası açık kalır. Tam Xray yapılandırmaları her zaman yeniden başlatılır."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisir un autre serveur le remplace dans le moteur en cours d’exécution, ce qui garde le port local actif. Les configurations Xray complètes entraînent toujours un redémarrage."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دوسرا سرور منتخب کرنے سے چلتے ہوئے کور کے اندر سرور بدل جاتا ہے، اس لیے مقامی پورٹ دستیاب رہتی ہے۔ مکمل Xray ترتیبات پر ہمیشہ دوبارہ آغاز ہوتا ہے۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecionar outro servidor substitui-o no núcleo em execução, pelo que a porta local se mantém ativa. As configurações completas do Xray provocam sempre um reinício."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Auswahl eines anderen Servers wird er im laufenden Kern ausgetauscht, sodass der lokale Port verfügbar bleibt. Vollständige Xray-Konfigurationen werden immer neu gestartet."
          }
        }
      }
    },
