    "No address answered. Your network may block Cloudflare, or the server is not behind it." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هیچ آدرسی پاسخ نداد. ممکن است شبکه‌ی شما Cloudflare را مسدود کند، یا سرور پشت آن نباشد."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ни один адрес не ответил. Ваша сеть может блокировать Cloudflare, или сервер не за ним."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有地址响应。你的网络可能封锁了 Cloudflare，或者该服务器不在其后。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يستجب أي عنوان. قد تحظر شبكتك Cloudflare، أو قد لا يكون الخادم خلفه."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có địa chỉ nào phản hồi. Mạng của bạn có thể chặn Cloudflare hoặc máy chủ không sử dụng Cloudflare."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有地址響應。你的網路可能封鎖了 Cloudflare，或者該伺服器不在其後。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "မည်သည့်လိပ်စာမျှ မတုံ့ပြန်ပါ။ သင့်ကွန်ရက်က Cloudflare ကို ပိတ်ဆို့ထားနိုင်သည်၊ သို့မဟုတ် ဆာဗာသည် ၎င်း၏နောက်တွင် မရှိပါ။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiçbir adres yanıt vermedi. Ağınız Cloudflare'i engelliyor olabilir veya sunucu Cloudflare arkasında olmayabilir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune adresse n’a répondu. Votre réseau bloque peut-être Cloudflare, ou le serveur n’est pas derrière Cloudflare."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کسی پتے نے جواب نہیں دیا۔ آپ کا نیٹ ورک Cloudflare کو مسدود کر رہا ہو سکتا ہے، یا سرور اس کے پیچھے نہیں ہے۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum endereço respondeu. A sua rede pode estar a bloquear a Cloudflare, ou o servidor pode não estar a usar a Cloudflare."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Adresse hat geantwortet. Ihr Netzwerk blockiert möglicherweise Cloudflare oder der Server verwendet Cloudflare nicht."
          }
        }
      }
