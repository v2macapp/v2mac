    "Approve V2Mac's privileged helper in System Settings → General → Login Items & Extensions, then reconnect." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کمک‌برنامه دارای دسترسی مدیر V2Mac را در تنظیمات سیستم ← عمومی ← موارد ورود و افزونه‌ها تأیید کنید، سپس دوباره وصل شوید."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одобрите привилегированный помощник V2Mac в Системные настройки → Основные → Объекты входа и расширения, затем подключитесь снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在系统设置 → 通用 → 登录项与扩展中批准 V2Mac 的特权辅助程序，然后重新连接。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وافق على مساعد V2Mac ذي الصلاحيات من إعدادات النظام ← عام ← عناصر تسجيل الدخول والملحقات، ثم أعد الاتصال."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy phê duyệt trình trợ giúp đặc quyền của V2Mac trong Cài đặt hệ thống → Cài đặt chung → Mục đăng nhập & Phần mở rộng, rồi kết nối lại."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在系統設定 → 通用 → 登錄項與擴展中批准 V2Mac 的特權輔助程序，然後重新連線。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "စနစ်ဆက်တင်များ → အထွေထွေ → အကောင့်ဝင်ချိန် စတင်မည့်အရာများနှင့် တိုးချဲ့မှုများတွင် V2Mac ၏ အထူးအခွင့်အရေးရှိ အကူပရိုဂရမ်ကို ခွင့်ပြုပြီး ပြန်ချိတ်ဆက်ပါ။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem Ayarları → Genel → Giriş Öğeleri ve Genişletmeler'de V2Mac'in ayrıcalıklı yardımcısını onaylayıp yeniden bağlanın."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l’utilitaire privilégié de V2Mac dans Réglages Système → Général → Ouverture et extensions, puis reconnectez-vous."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سسٹم کی ترتیبات → عمومی → لاگ اِن آئٹمز اور ایکسٹینشنز میں V2Mac کے بااختیار معاون کو منظوری دیں، پھر دوبارہ جڑیں۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
