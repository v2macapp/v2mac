    "V2Mac cannot replace itself in %@. Move it to Applications, or install the update by hand." : {
      "extractionState" : "manual",
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac نمی‌تواند خودش را در %@ جایگزین کند. آن را به پوشه Applications ببرید، یا به‌روزرسانی را دستی نصب کنید."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac не может заменить себя в %@. Переместите его в «Программы» или установите обновление вручную."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac 无法在 %@ 中替换自身。请将其移到“应用程序”文件夹，或手动安装更新。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع V2Mac استبدال نفسه في %@. انقله إلى «التطبيقات»، أو ثبّت التحديث يدويًا."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac không thể replace itself trong %@. Move it đến Applications, hoặc cài đặt cập nhật by hand."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac 無法在 %@ 中替換自身。請將其移到“應用程式”資料夾，或手動安裝更新。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac သည် %@ တွင် မိမိကိုယ်ကို အစားမထိုးနိုင်ပါ။ Applications သို့ ရွှေ့ပါ သို့မဟုတ် အပ်ဒိတ်ကို ကိုယ်တိုင်တပ်ဆင်ပါ။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac %@ konumunda kendini değiştiremiyor. Uygulamalar'a taşıyın veya güncellemeyi elle yükleyin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac ne peut pas se remplacer dans %@. Déplacez-le dans Applications ou installez la mise à jour manuellement."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac %@ میں اپنی جگہ نیا نسخہ نصب نہیں کر سکتا۔ اسے ایپلیکیشنز کے فولڈر میں منتقل کریں، یا تازہ کاری خود نصب کریں۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O V2Mac não se consegue substituir em %@. Mova-o para Aplicações ou instale a atualização manualmente."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac kann sich unter %@ nicht ersetzen. Verschieben Sie die App nach Programme oder installieren Sie das Update manuell."
          }
        }
      }
    },
