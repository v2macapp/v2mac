    "Could not check for the sandbox. Check your connection and try again." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بررسی سندباکس ممکن نشد. اتصال خود را بررسی کنید و دوباره امتحان کنید."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось проверить песочницу. Проверьте подключение и повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法检查沙盒。请检查网络连接后重试。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر التحقق من البيئة المعزولة. تحقق من اتصالك وحاول مجددًا."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể kiểm tra Hộp cát. Hãy kiểm tra kết nối rồi thử lại."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法檢查沙盒。請檢查網路連線後重試。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sandbox ကို မစစ်ဆေးနိုင်ပါ။ ချိတ်ဆက်မှုကို စစ်ဆေးပြီး ထပ်ကြိုးစားပါ။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sandbox denetlenemedi. Bağlantınızı kontrol edip yeniden deneyin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de vérifier la disponibilité du bac à sable. Vérifiez votre connexion et réessayez."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محفوظ ماحول کی دستیابی معلوم نہیں ہو سکی۔ اپنا کنکشن چیک کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível verificar a disponibilidade do ambiente isolado. Verifique a ligação e tente novamente."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verfügbarkeit der Sandbox konnte nicht geprüft werden. Prüfe deine Verbindung und versuche es erneut."
          }
