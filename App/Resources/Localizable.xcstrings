        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطابق قوائم geosite الأسماء، وتطابق قوائم geoip العناوين."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geosite lists match names, geoip lists match địa chỉ."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "geosite 列表匹配域名，geoip 列表匹配地址。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "geosite စာရင်းများသည် အမည်များနှင့် ကိုက်ညီစစ်ဆေးပြီး geoip စာရင်းများသည် လိပ်စာများနှင့် ကိုက်ညီစစ်ဆေးသည်။"
