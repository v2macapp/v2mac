    "Made on %@ with V2Mac %@: %lld subscriptions and %lld servers. What is missing here is added, nothing is removed, and the settings are replaced by the backup's." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Made on %1$@ with V2Mac %2$@: %3$lld subscriptions and %4$lld servers. What is missing here is added, nothing is removed, and the settings are replaced by the backup's."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ساخته‌شده در %1$@ با V2Mac %2$@: %3$lld اشتراک و %4$lld سرور. هرچه اینجا نیست اضافه می‌شود، چیزی حذف نمی‌شود و تنظیمات با تنظیمات پشتیبان جایگزین می‌شوند."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создана %1$@ в V2Mac %2$@: подписок — %3$lld, серверов — %4$lld. Недостающее будет добавлено, ничего не удалится, настройки заменятся настройками из копии."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "于 %1$@ 由 V2Mac %2$@ 创建：%3$lld 个订阅和 %4$lld 个服务器。此处缺少的内容会被添加，不会删除任何内容，设置将被备份中的设置替换。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُنشئ في %@ باستخدام V2Mac ‏%@: ‏%lld اشتراكًا و%lld خادمًا. سيُضاف ما هو مفقود هنا، ولن يُحذف شيء، وستُستبدل الإعدادات بإعدادات النسخة الاحتياطية."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Made trên %1$@ với V2Mac %2$@: %3$lld các gói đăng ký và %4$lld máy chủ. What là thiếu here là đã thêm, nothing là đã xóa, và cài đặt là replaced by backup's."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "於 %1$@ 由 V2Mac %2$@ 創建：%3$lld 個訂閱和 %4$lld 個伺服器。此處缺少的內容會被加入，不會刪除任何內容，設定將被備份中的設定替換。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ တွင် V2Mac %2$@ ဖြင့် ဖန်တီးထားသည်: စာရင်းသွင်းမှု %3$lld ခုနှင့် ဆာဗာ %4$lld ခု။ ဤနေရာတွင် လိုနေသောအရာများကို ထည့်မည်၊ မည်သည့်အရာကိုမျှ မဖယ်ရှားပါ။ ဆက်တင်များကို အရန်ကူးထဲရှိ ဆက်တင်များဖြင့် အစားထိုးမည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tarihinde V2Mac %2$@ ile oluşturuldu: %3$lld abonelik ve %4$lld sunucu. Buradaki eksikler eklenir, hiçbir şey kaldırılmaz ve ayarlar yedektekiyle değiştirilir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créé le %1$@ avec V2Mac %2$@ : %3$lld abonnements et %4$lld serveurs. Les éléments manquants ici sont ajoutés, rien n’est supprimé et les réglages sont remplacés par ceux de la sauvegarde."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ کو V2Mac %2$@ سے بنایا گیا: %3$lld سبسکرپشنز اور %4$lld سرورز۔ یہاں جو موجود نہیں وہ شامل کیا جائے گا، کچھ حذف نہیں ہو گا، اور ترتیبات بیک اپ کی ترتیبات سے بدل دی جائیں گی۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Criado em %1$@ com V2Mac %2$@: %3$lld subscrições e %4$lld servidores. O que faltar aqui será adicionado, nada será removido e as definições serão substituídas pelas da cópia de segurança."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellt am %@ mit V2Mac %@: %lld Abonnements und %lld Server. Fehlende Einträge werden hinzugefügt, nichts wird entfernt und die Einstellungen werden durch die der Sicherung ersetzt."
          }
        }
      }
