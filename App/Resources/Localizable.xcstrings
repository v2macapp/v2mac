    "A subscription replaces its servers on every update, so the edited copy is saved in Custom Configs." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اشتراک با هر به‌روزرسانی سرورهایش را عوض می‌کند، پس نسخه ویرایش‌شده در کانفیگ‌های دستی ذخیره می‌شود."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подписка заменяет свои серверы при каждом обновлении, поэтому изменённая копия сохраняется в «Свои конфигурации»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "订阅每次更新都会替换其服务器，因此编辑后的副本会保存在“自定义配置”中。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستبدل الاشتراك خوادمه عند كل تحديث، لذلك تُحفظ النسخة المعدّلة في «الإعدادات المخصصة»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gói đăng ký thay thế các máy chủ sau mỗi lần cập nhật, nên bản đã sửa được lưu trong Cấu hình tùy chỉnh."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訂閱每次更新都會替換其伺服器，因此編輯後的副本會保存在“自定義配置”中。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "စာရင်းသွင်းမှုသည် အပ်ဒိတ်တိုင်း ဆာဗာများကို အစားထိုးသဖြင့် ပြင်ထားသောမိတ္တူကို စိတ်ကြိုက်ဖွဲ့စည်းမှုများတွင် သိမ်းထားသည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonelik her güncellemede sunucularını değiştirdiği için düzenlenen kopya Özel Yapılandırmalar'a kaydedilir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un abonnement remplace ses serveurs à chaque mise à jour ; la copie modifiée est donc enregistrée dans Configurations personnalisées."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سبسکرپشن ہر اپ ڈیٹ پر اپنے سرورز بدل دیتی ہے، اس لیے ترمیم شدہ نقل حسب ضرورت ترتیبات میں محفوظ ہوتی ہے۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma subscrição substitui os seus servidores a cada atualização, por isso a cópia editada é guardada em Configurações personalizadas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Abonnement ersetzt seine Server bei jedem Update. Die bearbeitete Kopie wird deshalb unter Eigene Konfigurationen gespeichert."
          }
        }
      }
    },
