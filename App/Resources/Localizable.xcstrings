    "Routes all traffic on this Mac through the proxy, or only apps that use the local proxy." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همه ترافیک این مک را از پروکسی عبور می‌دهد، یا فقط برنامه‌هایی را که از پروکسی محلی استفاده می‌کنند."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пускает весь трафик этого Mac через прокси или только приложения, использующие локальный прокси."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让这台 Mac 的所有流量都走代理，或只让使用本地代理的应用走代理。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوجه كل حركة البيانات على هذا الـ Mac عبر الوكيل، أو فقط التطبيقات التي تستخدم الوكيل المحلي."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Routes tất cả lưu lượng trên this Mac qua proxy, hoặc chỉ ứng dụng that dùng local proxy."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓這台 Mac 的所有流量都走代理，或只讓使用本地代理的應用走代理。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဤ Mac ရှိ ဒေတာအားလုံး သို့မဟုတ် စက်တွင်းပရောက်စီသုံးသော အက်ပ်များကိုသာ ပရောက်စီမှတစ်ဆင့် ပို့သည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Mac'teki tüm trafiği veya yalnızca yerel proxy'yi kullanan uygulamaları proxy üzerinden yönlendirir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achemine via le proxy tout le trafic de ce Mac, ou uniquement celui des apps utilisant le proxy local."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس Mac کی تمام ٹریفک کو پراکسی کے ذریعے بھیجتا ہے، یا صرف ان ایپس کی ٹریفک کو جو مقامی پراکسی استعمال کرتی ہیں۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encaminha todo o tráfego deste Mac através do proxy ou apenas o das aplicações que usam o proxy local."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leitet den gesamten Datenverkehr dieses Macs oder nur Apps, die den lokalen Proxy verwenden, über den Proxy."
          }
        }
      }
    },
