    "Refuse the connection, for ads, trackers or anything unwanted." : {
      "extractionState" : "stale",
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رد کردن اتصال، برای تبلیغات، ردیاب‌ها یا هر چیز ناخواسته."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отклонять соединение — для рекламы, трекеров и всего ненужного."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拒绝连接，用于广告、跟踪器或任何不需要的内容。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرفض الاتصال للإعلانات أو أدوات التتبع أو أي شيء غير مرغوب."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refuse kết nối, cho ads, trackers hoặc anything unwanted."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拒絕連線，用於廣告、跟蹤器或任何不需要的內容。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ကြော်ငြာ၊ ခြေရာခံစနစ် သို့မဟုတ် မလိုချင်သောအရာများ၏ ချိတ်ဆက်မှုကို ငြင်းပယ်သည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reklamlar, izleyiciler veya istenmeyen her şey için bağlantıyı reddedin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloque la connexion pour les publicités, les traqueurs ou tout contenu indésirable."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اشتہارات، سراغ رساں عناصر یا کسی بھی ناپسندیدہ چیز کا کنکشن مسترد کریں۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
