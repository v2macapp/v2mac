    "This link may only be reachable through a VPN or proxy. Connect to a server first, then turn on “Fetch via proxy”." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این لینک ممکن است فقط از طریق VPN یا پروکسی در دسترس باشد. اول به یک سرور وصل شوید، بعد «دریافت از طریق پروکسی» را روشن کنید."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта ссылка может быть доступна только через VPN или прокси. Сначала подключитесь к серверу, затем включите «Загрузить через прокси»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此链接可能只能通过 VPN 或代理访问。请先连接服务器，然后开启“通过代理获取”。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد لا يمكن الوصول إلى هذا الرابط إلا عبر VPN أو وكيل. اتصل بخادم أولًا، ثم شغّل «الجلب عبر الوكيل»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This link may chỉ be reachable qua VPN hoặc proxy. kết nối đến máy chủ trước, then turn trên “Fetch via proxy”."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此連結可能只能通過 VPN 或代理訪問。請先連線伺服器，然後開啓“通過代理獲取”。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဤလင့်ခ်ကို VPN သို့မဟုတ် ပရောက်စီမှတစ်ဆင့်သာ ဝင်နိုင်ဖွယ်ရှိသည်။ ဆာဗာကို အရင်ချိတ်ပြီး “ပရောက်စီမှတစ်ဆင့် ရယူရန်” ကို ဖွင့်ပါ။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bağlantıya yalnızca VPN veya proxy üzerinden erişilebiliyor olabilir. Önce sunucuya bağlanıp “Proxy üzerinden al” seçeneğini açın."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce lien peut nécessiter un VPN ou un proxy. Connectez-vous d’abord à un serveur, puis activez « Récupérer via le proxy »."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ممکن ہے یہ ربط صرف VPN یا پراکسی کے ذریعے قابل رسائی ہو۔ پہلے کسی سرور سے جڑیں، پھر “پراکسی کے ذریعے حاصل کریں” فعال کریں۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta ligação pode estar acessível apenas através de uma VPN ou proxy. Ligue-se primeiro a um servidor e ative «Obter via proxy»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Link ist möglicherweise nur über ein VPN oder einen Proxy erreichbar. Verbinden Sie sich zuerst mit einem Server und aktivieren Sie dann „Über Proxy abrufen“."
          }
        }
      }
    },
