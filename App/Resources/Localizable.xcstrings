        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TUN မုဒ်: ဤ Mac ရှိ ဒေတာအားလုံးကို ပရောက်စီမှတစ်ဆင့် ပို့ပါ။ အထူးခွင့်ပြုချက်ရှိ အကူပရိုဂရမ် သို့မဟုတ် macOS စီမံခန့်ခွဲသူခွင့်ပြုချက် လိုအပ်သည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TUN modu: bu Mac'teki tüm trafiği proxy üzerinden yönlendirir. Ayrıcalıklı yardımcı veya macOS yönetici erişimi gerektirir."
          }
        },
        "fr" : {
          "stringUnit" : {
