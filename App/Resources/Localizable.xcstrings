          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reserved 必须是三个 0 到 255 之间的数字，用逗号分隔。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
