        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有已安裝或正在運行的程序。在此之前該規則不生效。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ထည့်သွင်းထားသော သို့မဟုတ် လည်ပတ်နေသောအရာ မရှိပါ။ ရှိလာသည်အထိ ဤစည်းမျဉ်းကို ချန်ထားမည်။"
          }
