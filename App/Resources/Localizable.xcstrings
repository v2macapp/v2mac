    "Xray refuses VLESS without TLS, REALITY or encryption; this server will fail to start" : {
      "extractionState" : "manual",
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xray پروتکل VLESS بدون TLS، REALITY یا رمزنگاری را نمی‌پذیرد؛ این سرور شروع نخواهد شد"
          }
        },
        "ru" : {
          "stringUnit" : {
