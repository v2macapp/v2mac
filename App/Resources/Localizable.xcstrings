    "Add apps, sites, addresses, countries or services. Any of them matching sends the traffic." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه، سایت، نشانی، کشور یا سرویس بیفزایید. تطابق هر یک از آن‌ها ترافیک را می‌فرستد."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте приложения, сайты, адреса, страны или сервисы. Совпадение любого из них направит трафик."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加应用、网站、地址、国家或服务。任何一项匹配即会发送流量。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف تطبيقات أو مواقع أو عناوين أو بلدانًا أو خدمات. يرسل تطابق أي منها حركة البيانات."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm ứng dụng, trang web, địa chỉ, quốc gia hoặc dịch vụ. Chỉ cần một mục khớp là lưu lượng sẽ được gửi."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入應用、網站、地址、國家或服務。任何一項匹配即會發送流量。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အက်ပ်၊ ဆိုက်၊ လိပ်စာ၊ နိုင်ငံ သို့မဟုတ် ဝန်ဆောင်မှုများ ထည့်ပါ။ တစ်ခုခု ကိုက်ညီလျှင် ဒေတာစီးဆင်းမှုကို ပို့မည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama, site, adres, ülke veya hizmet ekleyin. Herhangi biri eşleşirse trafik yönlendirilir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des apps, sites, adresses, pays ou services. Une seule correspondance suffit pour acheminer le trafic."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایپس، ویب سائٹس، پتے، ممالک یا خدمات شامل کریں۔ ان میں سے کسی کے بھی مطابق ہونے پر ٹریفک بھیجی جاتی ہے۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione aplicações, sites, endereços, países ou serviços. Basta uma correspondência para encaminhar o tráfego."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie Apps, Websites, Adressen, Länder oder Dienste hinzu. Sobald ein Eintrag zutrifft, wird der Datenverkehr entsprechend weitergeleitet."
          }
        }
      }
    },
