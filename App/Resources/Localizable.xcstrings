    "Browsers then fall back to TCP, so their host names reach the rules above." : {
      "extractionState" : "stale",
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرورگرها به TCP برمی‌گردند تا نام میزبان‌هایشان به قانون‌های بالا برسد."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Браузеры переходят на TCP, и имена хостов доходят до правил выше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浏览器会改用 TCP，这样其主机名就能交给上面的规则处理。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعود المتصفحات بعد ذلك إلى TCP، فتصل أسماء المضيفين إلى القواعد أعلاه."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau đó trình duyệt chuyển về TCP để tên máy chủ của chúng đi đến các quy tắc phía trên."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "瀏覽器會改用 TCP，這樣其主機名就能交給上面的規則處理。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ထို့နောက် ဘရောက်ဆာများက TCP ကို ပြောင်းသုံးသဖြင့် ၎င်းတို့၏ ဟို့စ်အမည်များကို အထက်ပါစည်းမျဉ်းများက စစ်ဆေးနိုင်သည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarayıcılar ardından TCP'ye döner; böylece ana makine adları yukarıdaki kurallara ulaşır."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les navigateurs utilisent alors TCP, ce qui permet aux règles ci-dessus de lire les noms d’hôte."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پھر براؤزر TCP استعمال کرتے ہیں، اس لیے ان کے میزبان نام اوپر کے قواعد تک پہنچتے ہیں۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os navegadores passam então a utilizar TCP, permitindo que as regras acima recebam os nomes dos servidores."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browser verwenden dann TCP, sodass ihre Hostnamen von den obigen Regeln erfasst werden."
          }
        }
      }
    },
    "Browsers try QUIC (UDP 443) first. Blocking it makes them use TCP, whose site names the rules can read." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرورگرها اول QUIC (UDP 443) را امتحان می‌کنند. مسدود کردن آن باعث می‌شود از TCP استفاده کنند که قانون‌ها نام سایتش را می‌خوانند."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Браузеры сначала пробуют QUIC (UDP 443). Его блокировка заставляет их использовать TCP, где правила видят имена сайтов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浏览器会先尝试 QUIC（UDP 443）。阻止它会让浏览器改用 TCP，规则可以读取其网站名称。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجرّب المتصفحات QUIC ‏(UDP 443) أولًا. إجبارها على استخدام TCP عبر حظره يسمح للقواعد بقراءة أسماء المواقع."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trình duyệt thử QUIC (UDP 443) trước. Chặn QUIC buộc chúng dùng TCP, nhờ đó quy tắc có thể đọc tên trang web."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "瀏覽器會先嘗試 QUIC（UDP 443）。阻止它會讓瀏覽器改用 TCP，規則可以讀取其網站名稱。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဘရောက်ဆာများသည် QUIC (UDP 443) ကို အရင်စမ်းသည်။ ၎င်းကိုပိတ်ဆို့လျှင် စည်းမျဉ်းများက ဆိုက်အမည်များ ဖတ်နိုင်သော TCP ကို ပြောင်းသုံးမည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarayıcılar önce QUIC (UDP 443) dener. Engellemek, kuralların site adlarını okuyabildiği TCP'yi kullanmalarını sağlar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les navigateurs essaient d’abord QUIC (UDP 443). Le bloquer les force à utiliser TCP, qui permet aux règles de lire les noms des sites."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "براؤزر پہلے QUIC (UDP 443) آزماتے ہیں۔ اسے مسدود کرنے سے وہ TCP استعمال کرتے ہیں، جس میں ویب سائٹس کے نام قواعد پڑھ سکتے ہیں۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os navegadores tentam utilizar QUIC (UDP 443) primeiro. Bloqueá-lo obriga-os a utilizar TCP, permitindo que as regras leiam os nomes dos sites."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browser versuchen zuerst QUIC (UDP 443). Wird es blockiert, verwenden sie TCP, dessen Websitenamen die Regeln lesen können."
          }
        }
      }
    },
