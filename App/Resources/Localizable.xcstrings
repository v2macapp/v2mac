    "Apple Intelligence suggests domains on this Mac. Check them before adding: the list can be wrong or incomplete." : {
      "extractionState" : "stale",
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence روی همین مک دامنه پیشنهاد می‌دهد. پیش از افزودن آن‌ها را بررسی کنید: فهرست ممکن است نادرست یا ناقص باشد."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence предлагает домены прямо на этом Mac. Проверьте их перед добавлением: список может быть неточным или неполным."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence 在本机上建议域名。添加前请检查：列表可能有误或不完整。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقترح Apple Intelligence نطاقات على هذا الـ Mac. تحقق منها قبل إضافتها: قد تكون القائمة خاطئة أو غير مكتملة."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence đề xuất các tên miền trên máy Mac này. Hãy kiểm tra trước khi thêm vì danh sách có thể sai hoặc thiếu."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence 在本機上建議域名。加入前請檢查：列表可能有誤或不完整。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence သည် ဤ Mac ပေါ်တွင် ဒိုမိန်းများ အကြံပြုသည်။ စာရင်း မှားနိုင် သို့မဟုတ် မပြည့်စုံနိုင်သဖြင့် မထည့်မီ စစ်ဆေးပါ။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence bu Mac'te alan adları önerir. Eklemeden önce kontrol edin: liste hatalı veya eksik olabilir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence suggère des domaines sur ce Mac. Vérifiez-les avant de les ajouter : la liste peut être erronée ou incomplète."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence اس Mac پر ڈومین تجویز کرتا ہے۔ شامل کرنے سے پہلے انہیں چیک کریں: فہرست غلط یا نامکمل ہو سکتی ہے۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence sugere domínios neste Mac. Verifique-os antes de os adicionar: a lista pode estar incorreta ou incompleta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence schlägt Domains auf diesem Mac vor. Prüfen Sie diese vor dem Hinzufügen: Die Liste kann fehlerhaft oder unvollständig sein."
          }
        }
      }
    },
