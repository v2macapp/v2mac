          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xray từ chối VLESS không có TLS, REALITY hoặc mã hóa; máy chủ này sẽ không khởi động được"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
