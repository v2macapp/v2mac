    "Choose a server first: the settings are tried against the server you connect with." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اول یک سرور انتخاب کنید: تنظیمات روی سروری امتحان می‌شوند که با آن وصل می‌شوید."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала выберите сервер: настройки проверяются на сервере, к которому вы подключаетесь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
