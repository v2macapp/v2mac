    "Your rules, Block QUIC and where traffic that matches no rule goes are in the Rules window." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قانون‌های شما، مسدود کردن QUIC و مقصد ترافیکی که با هیچ قانونی تطبیق ندارد در پنجرهٔ قانون‌ها هستند."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши правила, блокировка QUIC и путь трафика без совпадений — в окне «Правила»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的规则、阻止 QUIC 以及未匹配流量的去向都在“规则”窗口中。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توجد قواعدك و«حظر QUIC» ومسار حركة البيانات غير المطابقة في نافذة «القواعد»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Của bạn các quy tắc, chặn QUIC và where lưu lượng that matches no quy tắc goes là trong các quy tắc window."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的規則、阻止 QUIC 以及未匹配流量的去向都在“規則”窗口中。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင့်စည်းမျဉ်းများ၊ QUIC ပိတ်ဆို့မှုနှင့် စည်းမျဉ်းမကိုက်သော ဒေတာသွားမည့်နေရာတို့သည် စည်းမျဉ်းများဝင်းဒိုးတွင် ရှိသည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurallarınız, QUIC'i Engelle ve hiçbir kuralla eşleşmeyen trafiğin gideceği yer Kurallar penceresindedir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos règles, l’option Bloquer QUIC et la destination du trafic qui ne correspond à aucune règle se trouvent dans la fenêtre Règles."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے قواعد، QUIC کو روکنے کا اختیار اور کسی قاعدے سے مطابقت نہ رکھنے والی ٹریفک کا راستہ قواعد کی ونڈو میں ہیں۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As suas regras, o bloqueio QUIC e o destino do tráfego sem correspondência estão na janela Regras."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Regeln, QUIC blockieren und das Ziel für Datenverkehr ohne passende Regel finden Sie im Fenster Regeln."
