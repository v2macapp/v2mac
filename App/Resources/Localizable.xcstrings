    "Shows this session's traffic in the menu bar panel and the connection bar, and keeps a total." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترافیک این نشست را در پنل نوار منو و نوار اتصال نشان می‌دهد و مجموع را نگه می‌دارد."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
