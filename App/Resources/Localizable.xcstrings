    "Enter a number or a range such as %@. Until then %@ is used." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enter a number or a range such as %1$@. Until then %2$@ is used."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک عدد یا محدوده مثل %1$@ وارد کنید. تا آن موقع %2$@ استفاده می‌شود."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите число или диапазон, например %1$@. Пока используется %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入数字或范围，例如 %1$@。在此之前使用 %2$@。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل رقمًا أو نطاقًا مثل %@. حتى ذلك الحين سيُستخدم %@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter number hoặc range such as %1$@. Until then %2$@ là used."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請輸入數字或範圍，例如 %1$@。在此之前使用 %2$@。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ကဲ့သို့ ကိန်းဂဏန်း သို့မဟုတ် အပိုင်းအခြား ထည့်ပါ။ မထည့်မချင်း %2$@ ကို သုံးမည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ gibi bir sayı veya aralık girin. O zamana kadar %2$@ kullanılır."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez un nombre ou une plage comme %1$@. En attendant, %2$@ est utilisé."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کوئی عدد یا حد درج کریں، مثلاً %1$@۔ تب تک %2$@ استعمال ہو گا۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduza um número ou um intervalo, como %1$@. Até lá, será utilizado %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie eine Zahl oder einen Bereich wie %@ ein. Bis dahin wird %@ verwendet."
          }
        }
      }
    },
