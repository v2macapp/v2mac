          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reserved must be three numbers từ 0 đến 255, separated by commas."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reserved 必須是三個 0 到 255 之間的數字，用逗號分隔。"
