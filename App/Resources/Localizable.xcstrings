    "Nothing installed or running. The rule is left out until it is." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چیزی نصب یا در حال اجرا نیست. قانون تا آن موقع کنار گذاشته می‌شود."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не установлено и не запущено. До тех пор правило не действует."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有已安装或正在运行的程序。在此之前该规则不生效。"
